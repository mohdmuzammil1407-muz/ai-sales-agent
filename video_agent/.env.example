APP_NAME=vidio-agent
ENVIRONMENT=development
OPENAI_API_KEY=your_openai_api_key_here
DATABASE_URL=sqlite:///./vidio_agent.db
OTP_EXPIRY_MINUTES=10

# ── Google Calendar ──
# Path to your Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json

# The Google Calendar ID to create events on
# For primary calendar use: primary
# For a dedicated booking calendar: paste the calendar ID from Google Calendar settings
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_DELEGATED_USER=your_workspace_user@yourdomain.com

# Timezone for all meeting slots (IANA format)
MEETING_TIMEZONE=Asia/Kolkata

# Duration of each meeting slot in minutes
MEETING_DURATION_MINUTES=30

# How many days ahead to look for available slots
MEETING_LOOKAHEAD_DAYS=5

# Working hours for slot generation (24h format)
MEETING_HOURS_START=10
MEETING_HOURS_END=18

# Keep true for local testing until Google Calendar is configured
GOOGLE_CALENDAR_MOCK=true

# ── Email notifications (for meeting confirmations) ──
# SMTP settings for sending confirmation emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=studios@ilmoraai.com
SMTP_PASSWORD=your_app_password_here
MEETING_HOST_EMAIL=studios@ilmoraai.com
MEETING_HOST_NAME=Ilmora Studios

# OAuth-based Google Calendar integration (optional alternate setup)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://yourapp.com/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=your_refresh_token
CALENDAR_ID=primary
MEETING_TIMEZONE=Asia/Kolkata
MEETING_HOST_EMAIL=team@yourdomain.com
